# Cinefield provider worker — production container (Phase 6R Package B).
#
# Builds and runs ONLY the provider-worker runtime. The production image must
# never contain the repository's development toolchain: earlier revisions ran
# TypeScript through `tsx` in production and therefore copied every devDependency
# (including Supabase CLI, Depot CLI and esbuild) into the ECS image. Those tools
# were not reachable application features, but their bundled Go/native binaries
# materially expanded the vulnerability and attack surface.
#
# The build stage may use the locked development tree. The runtime receives one
# bundled JavaScript artifact and no node_modules directory at all.

# ---- build: resolve the worker graph and compile it once -------------------
FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json tsconfig.json ./
# Scripts are unnecessary for the bundle and can execute third-party install
# hooks. The lockfile is authoritative; no floating install occurs here.
RUN npm ci --ignore-scripts

# Build input only. Nothing copied into this stage automatically reaches the
# final image. Copying the complete source tree here is intentional: esbuild
# follows the REAL import graph from worker/provider-worker.ts and emits only
# reachable runtime code. This also prevents the former hand-maintained COPY
# allow-list from drifting behind new worker imports.
COPY worker ./worker
COPY src ./src
# The embedded policy engine imports this registry JSON at build time. It is
# bundled into the generated worker artifact; the policies directory itself is
# never copied to the final runtime stage.
COPY policies ./policies

# `esbuild` is already locked in package-lock.json by the repository toolchain.
# It is used only in this disposable build stage. `react-server` resolves the
# server-only marker to its non-throwing export while bundling. Third-party
# packages that are actually imported by the worker are bundled into this file;
# unrelated application packages (Next.js, Trigger.dev CLI, c2pa-node, etc.) do
# not enter the runtime merely because they exist in the monorepo dependency
# tree.
RUN ./node_modules/.bin/esbuild worker/provider-worker.ts \
      --bundle \
      --platform=node \
      --target=node22 \
      --format=cjs \
      --conditions=react-server \
      --tsconfig=tsconfig.json \
      --outfile=dist/provider-worker.cjs \
      --log-level=warning \
  && node --check dist/provider-worker.cjs

# ---- runtime: minimal long-lived ECS worker -------------------------------
# Alpine is sufficient because the provider worker bundle has no native-module
# runtime edge. The C2PA native processor is deliberately installed only by the
# Temporal/media runtime through the existing media-processor seam, not here.
FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app

# tini forwards ECS SIGTERM and reaps zombies. The stock Node image also ships
# npm/npx/corepack for developer convenience; this worker never installs
# packages at runtime, so retaining them only adds executable surface and their
# own transitive CVEs. Remove package managers while preserving the Node binary.
RUN apk add --no-cache tini \
  && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg /usr/local/bin/pnpm /usr/local/bin/pnpx \
  && addgroup -S -g 1001 cinefield \
  && adduser -S -D -u 1001 -G cinefield -h /app -s /sbin/nologin cinefield

COPY --from=build --chown=cinefield:cinefield /app/dist/provider-worker.cjs ./provider-worker.cjs

# Security invariant: the final stage intentionally has no application
# node_modules, package manager metadata, source tree, CLI binaries or build
# toolchain. Credentials continue to come only from the ECS task role / runtime
# environment; no secret or build argument is copied into the image.
USER cinefield

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "provider-worker.cjs"]
