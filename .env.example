FAL_KEY=your_fal_api_key_here

# Trigger.dev background job runner (Phase 3 foundation).
# None of these are required for direct-mode execution (the default).
#
# Secret — server-only, never NEXT_PUBLIC_. Required for the OPERATIONAL
# Trigger.dev tasks (reconciliation, audit, health, cleanup, cost). It no
# longer has anything to do with generation: as of Phase 6R-B, Trigger.dev is
# not a generation owner and cannot be made one by configuration.
TRIGGER_SECRET_KEY=
# Not a secret — safe to commit/share. The Trigger.dev project reference id
# from your project's dashboard settings page. Read by trigger.config.ts.
TRIGGER_PROJECT_REF=
#
# GENERATION_EXECUTION_MODE is RETIRED (Phase 6R-B). It used to select
# "direct" | "trigger"; both were generation lifecycle owners, and v1.6 makes
# Temporal the only one. The variable is no longer read by any code — setting
# it has no effect. Ownership is now TEMPORAL_GENERATION_ENABLED (below), and
# when that is off the execution boundary fails closed rather than falling
# back to another owner.
#
# Local development only, and ignored entirely by a production build: runs a
# generation inline in the request, bypassing Temporal. For debugging the
# orchestration core against mock models when you have no Temporal namespace.
# Never a fallback — the resolver reaches for it only when Temporal was never
# enabled in a non-production process, never because Temporal failed.
GENERATION_DIRECT_DEV_EXECUTION=false

# Cloudflare AI Gateway (Phase 5A foundation) — inactive by default.
# None of these are called anywhere yet; this is configuration only.
#
# App-level flag. Must be exactly "true" AND all three variables below must
# be present for isCloudflareEnabled() to return true. Credential presence
# alone never activates Cloudflare — see src/lib/cloudflare/gateway-config.ts.
CLOUDFLARE_AI_ENABLED=false
# Secret — server-only, never NEXT_PUBLIC_. Cloudflare account id.
CLOUDFLARE_ACCOUNT_ID=
# Secret — server-only, never NEXT_PUBLIC_. Cloudflare AI Gateway id.
CLOUDFLARE_AI_GATEWAY_ID=
# Secret — server-only, never NEXT_PUBLIC_. Cloudflare API token.
CLOUDFLARE_API_TOKEN=

# Temporal (Phase 6R.2 foundation) — inactive by default.
# Nothing starts a workflow yet; this is configuration only. When unset,
# getTemporalClient() throws TemporalNotConfiguredError and the existing
# direct/trigger execution paths are unaffected.
#
# In production these are injected into the ECS Fargate task from AWS Secrets
# Manager — never copied from .env.local, and never NEXT_PUBLIC_.
#
# Not a secret. `hostname:port`. Temporal Cloud looks like
# <namespace>.<account>.tmprl.cloud:7233
TEMPORAL_ADDRESS=
# Not a secret. Temporal Cloud namespace, e.g. cinefield-dev.<account>
TEMPORAL_NAMESPACE=
# Secret — server-only. Temporal Cloud API key.
# Set EITHER this OR the mTLS pair below, never both: supplying both is
# treated as unconfigured rather than silently picking one.
TEMPORAL_API_KEY=
# Secrets — server-only. Self-hosted mTLS alternative. PEM *contents*, not
# file paths. Both must be set together or neither.
TEMPORAL_CLIENT_CERT=
TEMPORAL_CLIENT_KEY=

# App-level flag, not a Temporal SDK variable. Not a secret, never
# NEXT_PUBLIC_. Must be exactly "true" AND a Temporal namespace must actually
# be configured. Credentials alone never switch ownership.
#
# PHASE 6R-B CHANGED WHAT "false" MEANS. It used to fall back to the
# direct/trigger execution paths. Those are gone: Temporal is the only
# production generation owner, so with this off a deployed
# /api/orchestration/execute returns 503 GENERATION_OWNER_UNAVAILABLE and
# starts nothing. That is deliberate — a fallback owner is how one generation
# acquires two lifecycles and, eventually, two provider charges.
#
# BEFORE SETTING THIS TO true IN A DEPLOYMENT, all three must hold:
#   1. a Temporal namespace is configured above and reachable
#   2. the generation worker is running (npm run temporal:worker) on the
#      cinefield-generation task queue
#   3. the client that calls the execution boundary can handle a 202
#      "queued" response by observing the row — the browser hook still keys
#      its polling off the retired `mode: "trigger"` field, so this must be
#      generalized first (Phase 5 /api/generate convergence)
TEMPORAL_GENERATION_ENABLED=false

# AWS SQS command transport (Phase 6R.4) — inactive by default.
#
# NO AWS ACCESS KEYS BELONG HERE OR ANYWHERE IN THIS FILE. Credentials come
# from the AWS SDK default provider chain: the ECS task role in production,
# an externally configured profile/SSO locally. Cinefield code never reads
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
#
# Not a secret. Locked production region is eu-central-1 (the code default);
# set only to override per environment.
AWS_REGION=eu-central-1
# App-level flag. Must be exactly "true" AND the queue URL below must be set
# for the Temporal submit activity to dispatch through SQS instead of
# submitting in-process. Queue configuration alone never activates dispatch.
SQS_COMMAND_BUS_ENABLED=false
# Not a secret (a queue URL identifies, it does not authenticate — IAM does).
# Full URL of the cinefield-provider.fifo queue, e.g.
# https://sqs.eu-central-1.amazonaws.com/<account-id>/cinefield-provider.fifo
CINEFIELD_SQS_PROVIDER_QUEUE_URL=

# Event schema registry / AWS Glue (Phase 6R.15) — inactive, NOT provisioned.
#
# Governance and DISTRIBUTION only. Cinefield validates every event against
# the in-repo registry (src/lib/events/event-schemas.ts) before publishing,
# whether or not Glue exists — enabling this never replaces that check.
#
# NO CREDENTIALS HERE. Glue would authenticate through the same AWS default
# provider chain as SQS (the ECS task role in production).
EVENT_SCHEMA_REGISTRY_ENABLED=false
# Not a secret (a registry name identifies, it does not authenticate).
# Region comes from AWS_REGION above.
GLUE_REGISTRY_NAME=
