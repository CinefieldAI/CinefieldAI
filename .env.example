FAL_KEY=your_fal_api_key_here

# Trigger.dev background job runner (Phase 3 foundation).
# None of these are required for direct-mode execution (the default).
#
# Secret — server-only, never NEXT_PUBLIC_. Presence of this key is what
# actually allows "trigger" execution mode to activate; leave unset in local
# dev until you have connected a real Trigger.dev project.
TRIGGER_SECRET_KEY=
# Not a secret — safe to commit/share. The Trigger.dev project reference id
# from your project's dashboard settings page. Read by trigger.config.ts.
TRIGGER_PROJECT_REF=
# App-level flag, not a Trigger.dev SDK variable. Only "trigger" has any
# effect, and only when TRIGGER_SECRET_KEY is also set — any other value or
# unset defaults to "direct" (synchronous, in-request execution).
GENERATION_EXECUTION_MODE=direct
