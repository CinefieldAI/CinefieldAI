# =============================================================================
# Cinefield environment contract — NAMES ONLY, NEVER VALUES
# =============================================================================
# Generated from src/lib/config/secret-registry.ts, which is the single
# inventory. A test asserts the two agree, so this file cannot fall behind the
# code and the code cannot introduce an undocumented variable.
#
# Copy to .env.local and fill in. .env.local is gitignored and must stay
# untracked — a test asserts both.
#
# Every line below is `NAME=` with no value. That is deliberate: a placeholder
# that looks like a credential trains people to paste real ones next to it,
# and trips secret scanners on a file that is meant to be committed.
#
# ANNOTATIONS
#   [PUBLIC]         shipped to the browser on purpose
#   [ID]             server-side but not a credential (region, bucket, flag)
#   [SERVER SECRET]  Cinefield's own data or identity plane
#   [INFRA SECRET]   infrastructure we pay for and store state in
#   [PROVIDER]       spend at a third party — a leak costs money immediately
#   [LOCAL ONLY]     must never exist in production; validation rejects it
#
# Rotation procedures: docs/runbooks/secret-rotation.md
# Leak response:       docs/runbooks/secret-leak.md
# Who holds what:      docs/security/least-privilege.md
# =============================================================================

# -----------------------------------------------------------------------------
# App / runtime
# -----------------------------------------------------------------------------
# [ID] optional — Set by the toolchain.
NODE_ENV=
# [ID] optional — Set by Vercel; production/preview/development.
VERCEL_ENV=
# [ID] required in production — Cinefield's own environment identity. See environment.ts.
CINEFIELD_ENV=
# [LOCAL ONLY] optional — Local media preview convenience.
CINEFIELD_LOCAL_PREVIEW=
# [LOCAL ONLY] optional — Inline execution for local debugging. Ignored in production.
GENERATION_DIRECT_DEV_EXECUTION=

# [LOCAL] optional — absolute path to the ffmpeg binary when it is not on
# PATH (Phase 9-C media transform). A tool location, never a credential: the
# transform child process is spawned with an EMPTY environment, so this value
# is read by the parent and never reaches ffmpeg itself.
CINEFIELD_FFMPEG_PATH=
# [LOCAL ONLY] deferred — no code reads it yet — RETIRED in 6R-B. Read by nothing; still present in some local files.
GENERATION_EXECUTION_MODE=
# [ID] optional — Names the moderation engine; not a credential.
CINEFIELD_MEDIA_MODERATION_ENGINE=
# [ID] optional — Phase 28-A. Names the prompt moderation engine; not a credential. The registry is empty, so any value resolves to no engine rather than to a permissive fallback.
CINEFIELD_PROMPT_MODERATION_ENGINE=
# [ID] optional — Phase 28-A. Names the reference-image (face/NCII/deepfake) evaluator; not a credential. The registry is empty, so any value resolves to no evaluator rather than to a permissive fallback — and with none configured a request carrying a reference image is REFUSED, not admitted unexamined.
CINEFIELD_REFERENCE_INPUT_EVALUATOR=
# [ID] optional — Phase 28-C. How many blocks make a repeat offender. UNSET by design — the roadmap names no number, and one invented here would be the number that closes a customer's account. Unset means enforcement reports BUSINESS_DECISION_REQUIRED.
CINEFIELD_REPEAT_VIOLATION_THRESHOLD=
# [ID] optional — Phase 28-C. The window the threshold above is counted over. Unset for the same reason.
CINEFIELD_REPEAT_VIOLATION_WINDOW_DAYS=
# [INFRA SECRET] optional — Operational tasks only. Not a generation owner since 6R-B.
TRIGGER_SECRET_KEY=
# [ID] optional — A project reference.
TRIGGER_PROJECT_REF=

# -----------------------------------------------------------------------------
# Clerk — authentication
# -----------------------------------------------------------------------------
# [PUBLIC] required in production — Designed to be public; identifies the Clerk instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# [SERVER SECRET] required in production — Full backend API authority over the identity plane.
CLERK_SECRET_KEY=
# [PUBLIC] optional — A path.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
# [PUBLIC] optional — A path.
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
# [PUBLIC] optional — A path.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
# [PUBLIC] optional — A path.
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=
# [SERVER SECRET] deferred — no code reads it yet — Phase 12-B. Named now so auth_failure signals have a producer later.
CLERK_WEBHOOK_SIGNING_SECRET=

# -----------------------------------------------------------------------------
# Supabase — database and storage
# -----------------------------------------------------------------------------
# [PUBLIC] required in production — Project URL; public by design.
NEXT_PUBLIC_SUPABASE_URL=
# [PUBLIC] required in production — Anon/publishable key. RLS is the real boundary.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# [SERVER SECRET] required in production — Bypasses RLS entirely. The highest-value secret in the system.
SUPABASE_SERVICE_ROLE_KEY=
# [LOCAL ONLY] optional — Supabase CLI token for local migration work. Never in a deployment.
SUPABASE_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Redis A — application state
# -----------------------------------------------------------------------------
# [ID] required in production — Explicit operator intent. Credentials alone never activate.
REDIS_ENABLED=
# [INFRA SECRET] required in production — Contains the password inline. Never logged, never returned.
REDIS_URL=

# -----------------------------------------------------------------------------
# Redis B — BullMQ queue state ONLY (deferred)
# -----------------------------------------------------------------------------
# Red note 244 and 6R.25: Redis B is BullMQ queue state ONLY, with its own
# credential and its own instance. validateConfiguration() fails closed if
# this resolves to the same target as REDIS_URL — sharing one instance means
# a BullMQ flush wipes rate-limit counters, leases and idempotency records.
# [ID] deferred — no code reads it yet — Separate database, separate credential (6R.25 / ¶1225).
BULLMQ_REDIS_ENABLED=
# [INFRA SECRET] deferred — no code reads it yet — MUST NOT equal REDIS_URL. Validated in environment.ts.
BULLMQ_REDIS_URL=

# -----------------------------------------------------------------------------
# Temporal — the only generation lifecycle owner
# -----------------------------------------------------------------------------
# In production these are injected into the ECS task from the approved secret
# mechanism — never copied from .env.local, and never NEXT_PUBLIC_.
# [ID] required in production — host:port.
TEMPORAL_ADDRESS=
# [ID] required in production — Carries the environment in its name — see environment.ts.
TEMPORAL_NAMESPACE=
# [INFRA SECRET] required in production — Temporal Cloud issues multiple concurrent API keys.
TEMPORAL_API_KEY=
# [INFRA SECRET] optional — mTLS alternative. PEM contents, not a path.
TEMPORAL_CLIENT_CERT=
# [INFRA SECRET] optional — mTLS alternative. Pairs with the cert.
TEMPORAL_CLIENT_KEY=
# [ID] required in production — Ownership switch. Off means the boundary fails closed.
TEMPORAL_GENERATION_ENABLED=

# -----------------------------------------------------------------------------
# Provider credentials — ONE SECRET PER PROVIDER
# -----------------------------------------------------------------------------
# Roadmap 1686: "Her provider ayri secret ve ayri scope kullanir; tek
# compromised CI logunun blast radius'u sinirlanir." There is deliberately NO
# shared PROVIDER_API_KEY — the build fails if one appears. Deferred entries
# are contract only; naming them now is the cheap half of the Phase 8
# precondition.
# [PROVIDER] optional — fal.ai.
FAL_KEY=
# [PROVIDER] optional — Google Gemini.
GEMINI_API_KEY=
# [PROVIDER] deferred — no code reads it yet — Phase 8. OpenAI issues multiple concurrent keys.
OPENAI_API_KEY=
# [PROVIDER] deferred — no code reads it yet — Phase 8.
ELEVENLABS_API_KEY=
# [PROVIDER] deferred — no code reads it yet — Phase 8.
RUNWARE_API_KEY=
# [PROVIDER] deferred — no code reads it yet — Phase 8. Runway's own variable name.
RUNWAYML_API_SECRET=
# [PROVIDER] deferred — no code reads it yet — Phase 8.
REPLICATE_API_TOKEN=
# [PROVIDER] deferred — no code reads it yet — Phase 8.
XAI_API_KEY=
# [PROVIDER] deferred — no code reads it yet — Phase 8.
KLING_API_KEY=
# [PROVIDER] deferred — no code reads it yet — Phase 8.
SEEDANCE_API_KEY=
# [PROVIDER] deferred — no code reads it yet — Phase 8. Azure issues key1/key2 precisely for rotation.
AZURE_OPENAI_API_KEY=
# [ID] deferred — no code reads it yet — Phase 8. A role ARN is assumed, never a stored key.
BEDROCK_ROLE_ARN=

# -----------------------------------------------------------------------------
# Cloudflare AI Gateway
# -----------------------------------------------------------------------------
# [ID] optional — Off by default.
CLOUDFLARE_AI_ENABLED=
# [ID] optional — An account identifier.
CLOUDFLARE_ACCOUNT_ID=
# [ID] optional — A gateway identifier.
CLOUDFLARE_AI_GATEWAY_ID=
# [INFRA SECRET] optional — Cloudflare allows multiple scoped tokens.
CLOUDFLARE_API_TOKEN=

# -----------------------------------------------------------------------------
# Cloudflare R2 — media storage
# -----------------------------------------------------------------------------
# [ID] required in production — An endpoint URL, no credential in it.
CLOUDFLARE_R2_ENDPOINT=
# [ID] required in production — A bucket name.
CLOUDFLARE_R2_BUCKET=
# [INFRA SECRET] required in production — R2 supports multiple concurrent API tokens.
CLOUDFLARE_R2_ACCESS_KEY_ID=
# [INFRA SECRET] required in production — Pairs with the access key id; rotated together.
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# AWS / SQS — durable command plane
# -----------------------------------------------------------------------------
# [ID] optional — A region name.
AWS_REGION=
# [ID] optional — Explicit operator intent.
SQS_COMMAND_BUS_ENABLED=
# [ID] optional — A queue URL. Authority is IAM, not the URL.
CINEFIELD_SQS_PROVIDER_QUEUE_URL=
# [ID] optional — Phase 15-D/3. The provider DLQ's URL, read only by the
# manual, read-only investigation entrypoint (scripts/dlq-investigate.ts).
# Authority is IAM, not the URL.
CINEFIELD_SQS_PROVIDER_DLQ_URL=

# -----------------------------------------------------------------------------
# Disaster recovery (Phase 9-D)
# -----------------------------------------------------------------------------
# [ID] optional — A bucket name.
CINEFIELD_DR_S3_BUCKET=
# [ID] optional — A region name.
CINEFIELD_DR_AWS_REGION=
# [LOCAL ONLY] optional — A local AWS CLI profile name. Production uses a task role.
CINEFIELD_DR_AWS_PROFILE=

# -----------------------------------------------------------------------------
# Kafka / schema registry — activation-ready, unset
# -----------------------------------------------------------------------------
# [ID] deferred — no code reads it yet — Unset. Kafka is activation-ready downstream distribution only.
KAFKA_ENABLED=
# [ID] deferred — no code reads it yet — Broker list.
KAFKA_BROKERS=
# [ID] deferred — no code reads it yet — Off.
EVENT_SCHEMA_REGISTRY_ENABLED=
# [ID] deferred — no code reads it yet — A registry name.
GLUE_REGISTRY_NAME=

# -----------------------------------------------------------------------------
# Billing (Phase 10, deferred)
# -----------------------------------------------------------------------------
# Phase 10 has not started. Named so the rotation contract exists before the
# capability; no code reads either.
# [SERVER SECRET] deferred — no code reads it yet — Phase 10. Named now; no code reads it.
STRIPE_SECRET_KEY=
# [SERVER SECRET] deferred — no code reads it yet — Phase 10. Stripe supports rolling with an overlap window.
STRIPE_WEBHOOK_SIGNING_SECRET=

# -----------------------------------------------------------------------------
# Security and policy
# -----------------------------------------------------------------------------
# [ID] optional — An allowlist of user ids. Empty means nobody is an admin.
ROUTE_ADMIN_CLERK_USER_IDS=
# [ID] optional — Phase 16/1. Bootstrap allowlist for the Admin Operations
# Center (/admin). Separate from ROUTE_ADMIN_CLERK_USER_IDS above.
CINEFIELD_ADMIN_CLERK_USER_IDS=
# [ID] optional — Phase 16-E. OPERATOR_MUTATION-tier role-separation allowlist.
CINEFIELD_ADMIN_OPERATOR_CLERK_USER_IDS=
# [ID] optional — Phase 16-E. HIGH_RISK_TIER0 role-separation allowlist. Empty
# (the default) means no one may perform a Tier-0 action.
CINEFIELD_ADMIN_TIER0_CLERK_USER_IDS=
# [ID] optional — Phase 16-E. Set to the literal "enforce" to hard-block a
# Tier-0 action denied by tier0-authorization.ts; anything else is shadow mode.
CINEFIELD_TIER0_ENFORCEMENT_MODE=

# -----------------------------------------------------------------------------
# Infra (Phase 18-D)
# -----------------------------------------------------------------------------
# [SECRET] optional — Shared bearer secret for POST /api/internal/infra/
# drift-report. Its only caller is the infra-drift.yml GitHub Actions job.
# Unset means every request is refused (fail closed).
CINEFIELD_INFRA_DRIFT_INGEST_TOKEN=

# -----------------------------------------------------------------------------
# Infra (Phase 25-D)
# -----------------------------------------------------------------------------
# [SECRET] optional — Shared bearer secret for POST /api/internal/secrets/
# access-anomaly, the CloudTrail->security.events bridge. Its only intended
# caller is a live EventBridge/Lambda forwarder. Unset means every request
# is refused (fail closed) — correct until infra/modules/secrets-manager/'s
# EventBridge wiring (CODE_COMPLETE_LIVE_DEFERRED) is applied.
CINEFIELD_SECRETS_ANOMALY_INGEST_TOKEN=

# -----------------------------------------------------------------------------
# [SECRET] optional — ES256 private key (PEM) that signs detached generated-
# media provenance claims (Phase 27). NEVER commit a value here. Supplied at
# runtime through the Phase 25 secret provider; rotated through Phase 25's
# secret.rotate (Tier-0, two-person). Unset means provenance is recorded
# UNSIGNED (marking_state EVIDENCE_RECORDED) rather than fabricated.
CINEFIELD_PROVENANCE_SIGNING_KEY_PEM=

# Bounded PUBLIC identifier naming which provenance signing key produced a
# signature. Not secret — it is the verification lookup handle, stored in
# media_provenance.signer_key_id. Never key material.
CINEFIELD_PROVENANCE_SIGNING_KEY_ID=
