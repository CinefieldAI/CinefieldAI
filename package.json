{
  "name": "wep-sitem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "catalog:generate": "tsx --conditions=react-server scripts/generate-public-catalog.ts",
    "temporal:worker": "tsx --conditions=react-server --env-file-if-exists=.env.local worker/temporal-worker.ts",
    "provider:worker": "tsx --conditions=react-server --env-file-if-exists=.env.local worker/provider-worker.ts",
    "realtime:dispatcher": "tsx --conditions=react-server --env-file-if-exists=.env.local worker/realtime-dispatcher-worker.ts",
    "policy:test": "opa test policies/ -v",
    "policy:eval": "opa eval -d policies/ --format pretty data.cinefield.policy.decision",
    "policy:build": "opa build -t wasm -e cinefield/policy/decision policies/ -o policies/bundle/policy.tar.gz",
    "policy:wasm-parity": "tsx scripts/policy-wasm-parity.ts",
    "secrets:scan": "tsx scripts/scan-secrets.ts",
    "telemetry:scan": "tsx scripts/scan-telemetry.ts",
    "contracts:generate-openapi": "tsx --conditions=react-server scripts/generate-openapi.ts",
    "contracts:generate-types": "tsx --conditions=react-server scripts/generate-api-types.ts",
    "contracts:generate": "npm run contracts:generate-openapi && npm run contracts:generate-types",
    "contracts:check-compat": "tsx --conditions=react-server scripts/check-contract-compatibility.ts",
    "contracts:check-openapi-compat": "tsx --conditions=react-server scripts/check-openapi-compatibility.ts",
    "eval:run": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/run-model-eval.ts",
    "eval:check-regression": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/check-model-eval-regression.ts",
    "eval:check-new-route-evidence": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/check-new-route-eval-evidence.ts",
    "media:worker": "tsx --conditions=react-server --env-file-if-exists=.env.local worker/media-worker.ts",
    "c2pa:verify-sample": "tsx --conditions=react-server scripts/verify-c2pa-sample.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/client-secrets-manager": "^3.1114.0",
    "@aws-sdk/client-sqs": "^3.1106.0",
    "@aws-sdk/credential-providers": "^3.1110.0",
    "@aws-sdk/s3-request-presigner": "^3.1110.0",
    "@clerk/nextjs": "^7.6.4",
    "@confluentinc/kafka-javascript": "^1.10.0",
    "@fal-ai/client": "^1.10.1",
    "@google/genai": "^2.15.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-hover-card": "^1.1.17",
    "@radix-ui/react-navigation-menu": "^1.2.16",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@supabase/supabase-js": "^2.112.0",
    "@temporalio/activity": "^1.22.0",
    "@temporalio/client": "^1.22.0",
    "@temporalio/worker": "^1.22.0",
    "@temporalio/workflow": "^1.22.0",
    "@trigger.dev/sdk": "4.5.9",
    "ai": "^6.0.209",
    "bullmq": "^6.0.11",
    "c2pa-node": "^0.5.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.41.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.21.0",
    "nanoid": "^5.1.16",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@open-policy-agent/opa-wasm": "^1.10.0",
    "@tailwindcss/postcss": "^4",
    "@temporalio/testing": "^1.22.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.61.1",
    "supabase": "^2.111.0",
    "tailwindcss": "^4",
    "tar": "^7.5.22",
    "trigger.dev": "^4.5.9",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
