      "expect": { "decision": "DENY", "reason": "ai_write_authority_off" }
    },
    {
      "name": "ai.tool.invoke is denied - the action itself is unimplemented",
      "patch": {
        "action": "ai.tool.invoke",
        "actor": { "id": "agent_seer", "role": "ai_agent", "kind": "ai_agent" }
      },
      "expect": { "decision": "DENY", "reason": "not_implemented" }
    },
    {
      "name": "Phase 14-B: code.pr.create by an allowlisted agent still needs human approval",
