      "expect": { "decision": "ALLOW", "reason": "allowed" }
    },
    {
      "name": "a temporarily blocked subject is denied even with the right role",
      "patch": { "risk": { "temporarilyBlocked": true, "adminReviewRequired": false, "challengeRequired": false } },
      "expect": { "decision": "DENY", "reason": "subject_temporarily_blocked" }
    },
    {
      "name": "a subject flagged for admin review gets REQUIRE_ADMIN_REVIEW, not an execution",
      "patch": { "risk": { "temporarilyBlocked": false, "adminReviewRequired": true, "challengeRequired": false } },
      "expect": { "decision": "REQUIRE_ADMIN_REVIEW", "reason": "risk_admin_review_required" }
    },
    {
      "name": "a subject flagged for challenge gets REQUIRE_CHALLENGE, and nothing pretends to serve one",
      "patch": { "risk": { "temporarilyBlocked": false, "adminReviewRequired": false, "challengeRequired": true } },
      "expect": { "decision": "REQUIRE_CHALLENGE", "reason": "risk_challenge_required" }
    },
    {
      "name": "a block outranks a review flag",
      "patch": { "risk": { "temporarilyBlocked": true, "adminReviewRequired": true, "challengeRequired": true } },
      "expect": { "decision": "DENY", "reason": "subject_temporarily_blocked" }
    },
    {
      "name": "a review flag outranks a challenge flag",
      "patch": { "risk": { "temporarilyBlocked": false, "adminReviewRequired": true, "challengeRequired": true } },
      "expect": { "decision": "REQUIRE_ADMIN_REVIEW", "reason": "risk_admin_review_required" }
    },
    {
      "name": "a clean reject is allowed",
      "patch": {},
      "expect": { "decision": "ALLOW", "reason": "allowed" }
    },
    {
      "name": "a release is allowed by policy but says two-person is enforced elsewhere",
