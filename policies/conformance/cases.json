{
  "note": "The single conformance suite. policy_test.rego iterates it and so does src/lib/policy/policy-engine.test.ts, so the Rego specification and the TypeScript runtime cannot drift apart without one of the two runs going red. Add a case here, never to only one side.",
  "baseInput": {
    "action": "media.quarantine.reject",
    "actor": { "id": "user_admin_1", "role": "route_admin", "kind": "human" },
    "tenantId": "user_owner_1",
    "resource": { "type": "media_asset", "id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa" },
    "risk": { "temporarilyBlocked": false, "adminReviewRequired": false, "challengeRequired": false },
    "approvalEvidence": { "humanApproved": false },
    "environment": "production",
    "originClass": "server",
    "correlationId": "corr-1"
  },
  "cases": [
    {
      "name": "an unknown action is denied rather than passed through",
      "patch": { "action": "media.quarantine.obliterate" },
      "expect": { "decision": "DENY", "reason": "unknown_action" }
    },
    {
      "name": "an empty action is denied",
      "patch": { "action": "" },
      "expect": { "decision": "DENY", "reason": "unknown_action" }
    },
    {
      "name": "data.export is now implemented (Phase 23) - without human approval evidence it blocks on approval, never a silent allow",
      "patch": { "action": "data.export" },
      "expect": { "decision": "REQUIRE_APPROVAL", "reason": "human_approval_required" }
    },
    {
      "name": "data.export with human approval evidence allows, but two-person is enforced downstream - policy alone never satisfies dual control",
      "patch": { "action": "data.export", "approvalEvidence": { "humanApproved": true } },
      "expect": { "decision": "ALLOW", "reason": "allowed_two_person_enforced_downstream" }
    },
    {
      "name": "data.delete is now implemented (Phase 23) - without human approval evidence it blocks on approval, never a silent allow",
      "patch": { "action": "data.delete" },
      "expect": { "decision": "REQUIRE_APPROVAL", "reason": "human_approval_required" }
    },
    {
      "name": "data.delete with human approval evidence allows, but two-person is enforced downstream - policy alone never satisfies dual control",
      "patch": { "action": "data.delete", "approvalEvidence": { "humanApproved": true } },
      "expect": { "decision": "ALLOW", "reason": "allowed_two_person_enforced_downstream" }
    },
    {
      "name": "retention.override is denied",
      "patch": { "action": "retention.override" },
      "expect": { "decision": "DENY", "reason": "not_implemented" }
    },
    {
      "name": "legal_hold.set is denied",
      "patch": { "action": "legal_hold.set" },
      "expect": { "decision": "DENY", "reason": "not_implemented" }
    },
    {
      "name": "legal_hold.clear is denied",
      "patch": { "action": "legal_hold.clear" },
      "expect": { "decision": "DENY", "reason": "not_implemented" }
    },
    {
      "name": "admin.review.resolve is denied - Phase 16 is not implemented",
      "patch": { "action": "admin.review.resolve" },
      "expect": { "decision": "DENY", "reason": "not_implemented" }
    },
    {
      "name": "secret.rotate is denied - Phase 12-D is not started",
      "patch": { "action": "secret.rotate" },
      "expect": { "decision": "DENY", "reason": "not_implemented" }
    },
    {
      "name": "account.suspend is denied - there is no ban mechanism to authorise",
      "patch": { "action": "account.suspend" },
      "expect": { "decision": "DENY", "reason": "not_implemented" }
    },
    {
      "name": "an actor with no id is denied, never treated as anonymous",
      "patch": { "actor": { "id": "", "role": "route_admin", "kind": "human" } },
      "expect": { "decision": "DENY", "reason": "unknown_subject" }
    },
    {
      "name": "an unknown role is denied by the subject check, not by authorization",
      "patch": { "actor": { "id": "user_admin_1", "role": "superuser", "kind": "human" } },
      "expect": { "decision": "DENY", "reason": "unknown_subject" }
    },
    {
      "name": "an unknown environment is denied",
