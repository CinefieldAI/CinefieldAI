      "expect": { "decision": "DENY", "reason": "untrusted_origin" }
    },
    {
      "name": "the AI check outranks the role check",
      "patch": { "actor": { "id": "agent_seer", "role": "member", "kind": "ai_agent" } },
      "expect": { "decision": "DENY", "reason": "ai_write_authority_off" }
    },
    {
