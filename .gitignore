# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# trigger.dev
.trigger/

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code
.claude/launch.json
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Cinefield handoff paketi (ChatGPT icin, repoya girmesin)
cinefield-handoff/
cinefield-handoff.zip

# Local video compression output — compare before swapping in, never deployed
video-compressed/

# Terraform / OpenTofu (Phase 6R.16)
# State can contain resolved resource attributes; tfvars can contain account
# ids and endpoints. Only *.example variable files are committed.
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# Phase 18-A: partial backend config carries the real state bucket/table —
# same reasoning and same *.example exception as tfvars above.
backend.hcl
!backend.hcl.example
.terraform/
crash.log
# .terraform.lock.hcl is deliberately NOT ignored — the provider lock file
# belongs in git so every apply resolves identical provider versions. It does
# not exist yet only because `init` has never been run here.
override.tf
override.tf.json

# Phase 19 — OPA WASM build output. Reproducible from policies/ + `npm run
# policy:build`; CI rebuilds it fresh rather than trusting a committed
# binary blob that could silently drift from the Rego source.
policies/bundle/
